{
  "metadata_schema_version": 2,
  "run": {
    "split": "val",
    "resolution": "mid"
  },
  "configuration": {
    "source": "legacy_metadata",
    "sha256": "",
    "snapshot_file": null,
    "use_gpu": true,
    "downscale_method": "opencv",
    "downscale_factors": [
      2,
      2,
      1
    ],
    "min_threshold_hu": -300,
    "max_threshold_percentile": 99.9,
    "threshold_method": "normal",
    "artery_segmentation_method": "region_growing"
  }
}